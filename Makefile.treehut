# To publish new Treehut images:
#
#   make --makefile=Makefile.treehut pub VERSION=17.0.0.1
#

VERSION :=

VERSION_PARTS := $(subst ., ,$(VERSION))

VER_MAJOR :=              $(word 1,$(VERSION_PARTS))
VER_MINOR := $(VER_MAJOR).$(word 2,$(VERSION_PARTS))
VER_PATCH := $(VER_MINOR).$(word 3,$(VERSION_PARTS))
VER_REV   := $(VER_PATCH).$(word 4,$(VERSION_PARTS))

DOCKER ?= docker

ARGFLAGS := --build-arg RELEASE_VERSION=$(VER_PATCH) --build-arg TREEHUT_VERSION=$(VER_REV)

TEST_TAG := treehut:testing

test: check-version
	$(DOCKER) build $(ARGFLAGS) -t $(TEST_TAG) .
	$(DOCKER) run --name treehut-mini --rm \
		-p 127.0.0.1:3022:3022 \
		-p 127.0.0.1:3000:3000 \
		-v $(PWD)/.scratch/data:/data \
		$(TEST_TAG)
.PHONY: test

IMAGE := ghcr.io/treehut/treehut
IMAGE_TAGS := latest $(VER_MAJOR) $(VER_MINOR) $(VER_PATCH) $(VER_REV)
TAGFLAGS := $(addprefix -t $(IMAGE):,$(IMAGE_TAGS))

# pub: check-version
# 	$(DOCKER) buildx build --push --platform linux/amd64 $(ARGFLAGS) $(TAGFLAGS) .
# .PHONY: pub

# `docker push` takes one image per call, so each tag is pushed separately.
pub: check-version
	$(DOCKER) build --platform linux/amd64 $(ARGFLAGS) $(TAGFLAGS) .
	$(DOCKER) push ghcr.io/treehut/treehut
	$(DOCKER) push ghcr.io/treehut/treehut ghcr.io/treehut/treehut:$(VER_MAJOR)
	$(DOCKER) push ghcr.io/treehut/treehut ghcr.io/treehut/treehut:$(VER_MINOR)
	$(DOCKER) push ghcr.io/treehut/treehut ghcr.io/treehut/treehut:$(VER_PATCH)
	$(DOCKER) push ghcr.io/treehut/treehut ghcr.io/treehut/treehut:$(VER_REV)

check-version:
	@echo "$(VERSION)" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$$' || { echo "please specify a full VERSION= (ie. 17.0.0.1)"; exit 1; }
.PHONY: check-version
